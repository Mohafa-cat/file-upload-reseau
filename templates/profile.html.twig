{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}

<div class="profile">
    <div class="profile-header">
        <div class="profile-header-cover"></div>
        <div class="profile-header-content">

            <div class="profile-header-img">
                <img src="{{ profile_picture }}" alt="profile picture">
            </div>
            
            <div class="profile-header-info">
                <h4 class="m-t-10 m-b-5">Michael Myers</h4>
                <p class="m-b-10">Informaticien</p>
                <div id="error" class="error-message hidden">Une erreur est survenue</div>
            </div>

            <form id="upload-form" class="profile-header-form" method="post" enctype="multipart/form-data" action="{{ path(upload_route) }}">
                <input type="file" name="file" id="profile_picture" class="inputfile" required>
                <label for="profile_picture">Choisissez une image</label>
                <button type="submit" id="upload-button" class="btn btn-sm">Téléverser une nouvelle image</button>
            </form>
            {# Flash messages #}
            {% for message in app.flashes('error') %}
                <div class="alert">
                    {{ message }}
                    <button class="close-btn" onclick="this.parentElement.style.display='none'">&times;</button>
                </div>
            {% endfor %}
        </div>
    </div>

<div class="profile-body">
    <div class="content-panel about-me">
      <h4 class="content-title">À propos de moi 💬</h4>
      <p>Passionné par la cybersécurité et le développement web, j’aime créer des applications modernes et sécurisées.</p>
    </div>

    <div class="content-panel my-projects">
      <h4 class="content-title">Mes projets 🚀</h4>
      <ul class="projects-list">
        <li>Portfolio V3</li>
        <li>E-commerce Backend</li>
        <li>NodeJS Microservice</li>
      </ul>
    </div>

    <div class="content-panel my-skills-card">
      <h4 class="content-title">Mes compétences 🛠️</h4>
      <div class="skill-tags-container">
        <span class="skill-tag">HTML</span>
        <span class="skill-tag">CSS</span>
        <span class="skill-tag">JavaScript</span>
        <span class="skill-tag">PHP</span>
        <span class="skill-tag">SQL</span>
        <span class="skill-tag">Symfony</span>
      </div>
    </div>
  </div>

</div>


{% endblock %}
